# ==============================================================================
# NEXUS DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Entorno de ejecución: development | production | test
NODE_ENV="development"

# URL pública de la aplicación (o a través de Caddy en Hetzner)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NEXTAUTH (AUTH.JS v5)
# Generar clave con: openssl rand -base64 33
AUTH_SECRET="your-ultra-secure-random-secret-key-min-32-chars"
# En Auth.js v5 se usa AUTH_SECRET / NEXTAUTH_URL
NEXTAUTH_URL="http://localhost:3000"

# DATABASE CONNECTION (PostgreSQL)
# Desarrollo Local: Contenedor Podman local_postgres
# Producción Hetzner: postgresql://devuser:<secret>@db-node.internal:5432/devdb (Systemd nativo)
DATABASE_URL="postgresql://devuser:devpassword@localhost:5432/devdb"

# Parámetros del Pool de PostgreSQL (Desacoplados para inter-nodo o localhost)
DB_SSL="false"
DB_MAX_CONNECTIONS="10"
DB_IDLE_TIMEOUT="20"
DB_CONNECT_TIMEOUT="10"

# RATE LIMITING (/api/auth)
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="5"
