# ==============================================================================
# NEXUS DASHBOARD - ENTORNO DE PRODUCCIÓN (HETZNER CLUSTER PRIVADO 10.0.0.0/24)
# ==============================================================================
# Ubicación en app-node: /opt/apps/nexus-dashboard/.env.production
# Usuario de ejecución: root

# Runtime y Red
NODE_ENV="production"
PORT=8090
HOSTNAME="10.0.0.2"
NEXT_PUBLIC_APP_URL="https://nexus.filenode.dev"

# Persistencia de Base de Datos (db-node dedicado por LAN privada)
# sslmode=disable para evitar overhead innecesario dentro de la red interna protegida
DATABASE_URL="postgresql://nexus_user:TuPasswordSeguro@10.0.0.3:5432/nexus_db?sslmode=disable"
DB_SSL="false"
DB_MAX_CONNECTIONS="10"
DB_IDLE_TIMEOUT="20"
DB_CONNECT_TIMEOUT="10"

# Autenticación Táctica & Cookies Seguras
# Generar clave con: openssl rand -base64 33
AUTH_SECRET="GenerarCon_openssl_rand_base64_33_Minimo32Caracteres"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://nexus.filenode.dev"

# Rate Limiting Táctico
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="10"
