[Unit]
Description=Nexus Dashboard - Project & Infrastructure Tactical HUD
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/apps/nexus-dashboard
EnvironmentFile=/opt/apps/nexus-dashboard/.env.production

# Ejecución del bundle standalone generado por Next.js en puerto 8090
ExecStart=/usr/bin/node /opt/apps/nexus-dashboard/.next/standalone/server.js

Restart=always
RestartSec=5s
KillMode=process

# Límites de descriptores y memoria en servidor Linux
LimitNOFILE=65535
MemoryMax=1G

[Install]
WantedBy=multi-user.target
